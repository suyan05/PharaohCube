--- !u!114 &1154803212
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1154803207}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: be969ae6574377f4da79ea11dce65793, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DigIntroCutscene
  title: "\uAE30\uC790 \uACE0\uC6D0 \uB0A8\uCABD, \uBC1C\uAD74 \uCEA0\uD504"
  subtitle: "\uBC1C\uAD74 47\uC77C\uC9F8"
  titleSeconds: 2.2
  tentDoor: {x: 4, y: 7.4}
  tentFront: {x: 4, y: 6.3}
  lamentSpot: {x: 5.6, y: 6.1}
  radioSpot: {x: 3.4, y: 4.5}
  zoneView: {x: 22, y: 5}
  radio: {fileID: 1622428040}
  closeSize: 4.5
  zoneSize: 5
  dustSprites:
  - {fileID: 21300000, guid: b60d0a1572a17a44f97d070193dde03c, type: 3}
  - {fileID: 21300000, guid: 617645dfbe4ccb14a9af0a084f9f7c45, type: 3}
  - {fileID: 21300000, guid: ee9fa6c787a170e47af8fecd776b35eb, type: 3}
  windLoop: {fileID: 0}
  gustSfx: {fileID: 0}
  radioStaticSfx: {fileID: 0}
  sighLines:
  - speaker: "\uB098"
    text: "\uD6C4\uC6B0..."
    portrait: {fileID: 0}
  gustLines:
  - speaker: "\uB098"
    text: "\uCF5C\uB85D, \uCF5C\uB85D...! \uBAA8\uB798\uBC14\uB78C \uD55C\uBC88 \uC9C0\uB3C5\uD558\uB124."
    portrait: {fileID: 0}
  lamentLines:
  - speaker: "\uB098"
    text: "\uBC8C\uC368 47\uC77C\uC9F8... \uC624\uB298\uB3C4 \uD1A0\uAE30 \uC870\uAC01\uC774\uB098
      \uC90D\uB2E4 \uB05D\uB098\uACA0\uC9C0."
    portrait: {fileID: 0}
  - speaker: "\uB098"
    text: "'\uC5EC\uC12F \uC2E0\uC758 \uC2E0\uC804'\uC774\uB77C\uB2C8. \uC815\uB9D0
      \uC774 \uBAA8\uB798 \uBC11\uC5D0 \uC788\uAE34 \uD55C \uAC78\uAE4C."
    portrait: {fileID: 0}
  staticLines:
  - speaker: "\uBB34\uC804\uAE30"
    text: "\uCE58\uC9C1... \uCE58\uC9C0\uC9C1..."
    portrait: {fileID: 0}
  radioLines:
  - speaker: "\uBB34\uC804 (\uD0D0\uC0AC\uB300\uC7A5)"
    text: "...\uCEA0\uD504, \uB4E4\uB9AC\uB098? \uC5EC\uAE30 \uBCF8\uBD80\uB2E4."
    portrait: {fileID: 0}
  - speaker: "\uB098"
    text: "\uB124, \uB4E4\uB9BD\uB2C8\uB2E4!"
    portrait: {fileID: 0}
  - speaker: "\uBB34\uC804 (\uD0D0\uC0AC\uB300\uC7A5)"
    text: "\uC5B4\uC82F\uBC24 \uBAA8\uB798\uD3ED\uD48D\uC5D0 \uB0A8\uB3D9\uCABD B\uAD6C\uC5ED
      \uD45C\uCE35\uC774 \uC4F8\uB824\uB098\uAC14\uB2E4. \uBB54\uAC00 \uB4DC\uB7EC\uB0AC\uC744\uC9C0\uB3C4
      \uBAB0\uB77C."
    portrait: {fileID: 0}
  - speaker: "\uBB34\uC804 (\uD0D0\uC0AC\uB300\uC7A5)"
    text: "\uC5B4\uC81C \uC77C\uC9C0 \uB2E4\uC2DC \uD655\uC778\uD558\uACE0, \uBD93
      \uCC59\uACA8\uC11C \uAC00\uBD10. \uC870\uC2EC\uD558\uACE0. \uCE58\uC9C1..."
    portrait: {fileID: 0}
  - speaker: "\uB098"
    text: "B\uAD6C\uC5ED... \uC54C\uACA0\uC2B5\uB2C8\uB2E4!"
    portrait: {fileID: 0}
  zoneLines:
  - speaker: "\uB098"
    text: "\uB85C\uD504 \uCCD0\uB454 \uC800\uAE30\uAC00 B\uAD6C\uC5ED\uC774\uC9C0.
      \uC77C\uC9C0\uBD80\uD130 \uBCF4\uACE0, \uC7A5\uBE44 \uC0C1\uC790\uC5D0\uC11C
      \uBD93\uC744 \uCC59\uAE30\uC790."
    portrait: {fileID: 0}
