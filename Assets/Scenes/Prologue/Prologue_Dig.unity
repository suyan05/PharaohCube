  grainSprites:
  - {fileID: 21300000, guid: b60d0a1572a17a44f97d070193dde03c, type: 3}
  - {fileID: 21300000, guid: 617645dfbe4ccb14a9af0a084f9f7c45, type: 3}
  - {fileID: 21300000, guid: ee9fa6c787a170e47af8fecd776b35eb, type: 3}
  grainCount: 28
  grainSpread: 2.5
  grainSortingOrder: 1
  rumbleSfx: {fileID: 0}
  radioStaticSfx: {fileID: 0}
  collapseSfx: {fileID: 0}
  rumbleLines:
  - speaker: "\uB098"
    text: "...\uC751? \uB545\uC774 \uC6B8\uB9AC\uB294\uB370?"
    portrait: {fileID: 0}
  radioWarnLines:
  - speaker: "\uBB34\uC804 (\uD0D0\uC0AC\uB300\uC7A5)"
    text: "\uCE58\uC9C1- B\uAD6C\uC5ED \uC544\uB798\uB294- \uCE58\uC9C0\uC9C1- \uBE48
      \uACF5\uAC04\uC77C \uC218\uB3C4- \uB2F9\uC7A5 \uB098\uC640-!"
    portrait: {fileID: 0}
  fallLines:
  - speaker: "\uB098"
