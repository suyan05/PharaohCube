  m_Script: {fileID: 11500000, guid: 61e9318b2de1e8e46bed38461fdf0fdd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SandPileGroup
  piles:
  - {fileID: 53699385}
  - {fileID: 474824968}
  - {fileID: 1764846550}
  firstLines:
  - speaker: "\uB098"
    text: "\uAE68\uC9C4 \uD1A0\uAE30 \uC870\uAC01\uC774\uB2E4."
    portrait: {fileID: 0}
  laterLines:
  - speaker: "\uB098"
    text: "\uB610 \uD1A0\uAE30\uB2E4... \uC5ED\uC2DC \uADF8\uB807\uC9C0 \uBB50."
    portrait: {fileID: 0}
  scarabItem: COL_SCARAB
  foundFlag: F_PRO_SCARAB_FOUND
  scarabSprite: {fileID: 21300000, guid: 8a16e05c7606ae2479e1faae746f7d5e, type: 3}
  closeUpSize: 3.5
  beforeLines:
  - speaker: "\uB098"
    text: "...\uC7A0\uAE50. \uBAA8\uB798 \uBC11\uC5D0 \uBB54\uAC00 \uBC18\uC9DD\uC774\uB294\uB370?"
    portrait: {fileID: 0}
  afterLines:
  - speaker: "\uB098"
    text: "\uCCAD\uB85D\uC0C9 \uC2A4\uCE74\uB77C\uBE0C...! \uC9C4\uC9DC \uC720\uBB3C\uC774\uC57C!"
    portrait: {fileID: 0}
  - speaker: "\uB098"
    text: "47\uC77C \uB9CC\uC5D0 \uCC98\uC74C\uC774\uB77C\uACE0! \uBE68\uB9AC \uBCF8\uBD80\uC5D0
      \uC54C\uB824\uC57C..."
    portrait: {fileID: 0}
  dustSprites:
  - {fileID: 21300000, guid: b60d0a1572a17a44f97d070193dde03c, type: 3}
  - {fileID: 21300000, guid: 617645dfbe4ccb14a9af0a084f9f7c45, type: 3}
  - {fileID: 21300000, guid: ee9fa6c787a170e47af8fecd776b35eb, type: 3}
  brushDoneSfx: {fileID: 0}
  glintSfx: {fileID: 0}
  collapse: {fileID: 1154803210}
