--- !u!114 &732389687
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 732389684}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c38c4312d6ce5364e916f048865dff75, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SphinxDreamDirector
  wake: {fileID: 732389688}
  head: {fileID: 1780971297}
  pawSands:
  - {fileID: 1271373924}
  - {fileID: 1543095530}
  stele: {fileID: 1433928824}
  steleRenderer: {fileID: 1433928822}
  steleShownSprite: {fileID: -848121916837563334, guid: ba9a061d95f4577429a0656b284fffba, type: 3}
  stairs: {fileID: 1077686197}
  brushItem: TOOL_BRUSH
  lensItem: TOOL_LENS
  steleFlag: F_PRO_STELE_SHOWN
  grantBrushIfMissing: 1
  objectiveSand: "\uC2A4\uD551\uD06C\uC2A4\uC758 \uC55E\uBC1C\uC744 \uB36E\uC740
    \uBAA8\uB798\uB97C \uD138\uC5B4\uB0B4\uC790"
  objectiveLens: "\uBE44\uC11D\uC744 \uB80C\uC988\uB85C \uC77D\uC5B4\uBCF4\uC790"
  objectiveStairs: "\uC5F4\uB9B0 \uACC4\uB2E8\uC73C\uB85C \uB0B4\uB824\uAC00\uC790"
  dustSprites:
  - {fileID: 21300000, guid: b60d0a1572a17a44f97d070193dde03c, type: 3}
  - {fileID: 21300000, guid: 617645dfbe4ccb14a9af0a084f9f7c45, type: 3}
  - {fileID: 21300000, guid: ee9fa6c787a170e47af8fecd776b35eb, type: 3}
  dustColor: {r: 0.72, g: 0.64, b: 0.77, a: 0.9}
  rumbleSfx: {fileID: 0}
  lines:
    firstPaw:
    - speaker: "\uB098"
      text: "\uBAA8\uB798 \uC544\uB798\uB85C \uAC70\uB300\uD55C \uB3CC \uBC1C\uD1B1\uC774
        \uB4DC\uB7EC\uB0AC\uB2E4. \uBC18\uB300\uCABD\uB3C4..."
      portrait: {fileID: 0}
    steleRevealed:
    - speaker: "\uB098"
      text: "\uC55E\uBC1C \uC0AC\uC774\uC5D0\uC11C... \uBE44\uC11D\uC774 \uC19F\uC544\uC62C\uB790\uC5B4!"
      portrait: {fileID: 0}
    riddle:
      speaker: "\uC2A4\uD551\uD06C\uC2A4"
      text: "\uC544\uCE68\uC5D0\uB294 \uC1E0\uB625\uAD6C\uB9AC\uB85C \uD0DC\uC5B4\uB098\uACE0,
        \uD55C\uB0AE\uC5D0\uB294 \uB9E4\uAC00 \uB418\uBA70, \uC800\uB141\uC5D0\uB294
        \uB178\uC778\uC774 \uB418\uC5B4 \uB215\uB294\uB2E4. \uB098\uB294 \uB204\uAD6C\uC778\uAC00?"
      portrait: {fileID: 0}
    options:
    - "\uD0DC\uC591"
    - "\uB098\uC77C\uAC15"
    - "\uD30C\uB77C\uC624"
    correctIndex: 0
    wrong:
    - speaker: "\uC2A4\uD551\uD06C\uC2A4"
      text: "\uB2E4\uC2DC \uC0DD\uAC01\uD558\uB77C. \uB9E4\uC77C \uB3D9\uCABD\uC5D0\uC11C
        \uB098\uC11C \uC11C\uCABD\uC73C\uB85C \uC9C0\uB294 \uC790\uB2E4."
      portrait: {fileID: 0}
    right:
    - speaker: "\uC2A4\uD551\uD06C\uC2A4"
      text: "\uADF8\uB807\uB2E4. \uCF00\uD504\uB9AC, \uB77C, \uC544\uD23C. \uD0DC\uC591\uC740
        \uC138 \uC774\uB984\uC73C\uB85C \uD558\uB8E8\uB97C \uAC77\uB294\uB2E4."
      portrait: {fileID: 0}
    - speaker: "\uC2A4\uD551\uD06C\uC2A4"
      text: "\uC774 \uB80C\uC988\uB97C \uAC00\uC838\uAC00\uB77C. \uC2E0\uB4E4\uC758
        \uAE00\uC744 \uC77D\uC744 \uC218 \uC788\uC744 \uAC83\uC774\uB2E4."
      portrait: {fileID: 0}
    afterLens:
    - speaker: "\uB098"
      text: "\uB80C\uC988... \uC774\uAC78\uB85C \uBE44\uC11D\uC744 \uBE44\uCDB0\uBCF4\uB77C\uB294
        \uAC74\uAC00."
      portrait: {fileID: 0}
    decodeTitle: "\uAFC8\uC758 \uBE44\uC11D"
    decodeBody: "\uC5EC\uC12F \uC2E0\uC758 \uC2DC\uD5D8\uC744\n\uD1B5\uACFC\uD55C
      \uC790\uB9CC\uC774\n\uD050\uBE0C\uC758 \uBE5B\uC744 \uBCF8\uB2E4.\n\n\uCCAB
      \uBB38\uC740\n\uD0DC\uC591\uC758 \uC2E0\uC774 \uC9C0\uD0A8\uB2E4."
    afterDecode:
    - speaker: "\uB098"
      text: "\uC5EC\uC12F \uC2E0\uC758 \uC2DC\uD5D8... \uCCAB \uBB38\uC740 \uD0DC\uC591\uC758
        \uC2E0. \uB77C\uC758 \uC2E0\uC804\uC778\uAC00?"
      portrait: {fileID: 0}
    farewell:
    - speaker: "\uC2A4\uD551\uD06C\uC2A4"
      text: "\uBAA8\uB798\uB97C \uD5E4\uCE5C \uC790\uC5EC, \uC544\uB798\uB85C \uB0B4\uB824\uAC00\uB77C."
      portrait: {fileID: 0}
    - speaker: "\uC2A4\uD551\uD06C\uC2A4"
      text: "\uD0DC\uC591\uC774 \uB108\uB97C \uAE30\uB2E4\uB9B0\uB2E4."
      portrait: {fileID: 0}
--- !u!114 &732389688
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 732389684}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2211c8b9c83e1e64daca2eaf06ff5af7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SphinxWakeCutscene
  head: {fileID: 1780971297}
  wakePoint: {x: 4.5, y: 2.5}
  closeSize: 3.5
  wideSize: 7
  droneLoop: {fileID: 0}
  voiceText: "...\uC77C\uC5B4\uB098\uAC70\uB77C."
  wakeLines:
  - speaker: "\uB098"
    text: "\uC73C\uC73D... \uC5EC\uAE30\uB294...?"
    portrait: {fileID: 0}
  - speaker: "\uB098"
    text: "\uBD84\uBA85 \uAD6C\uBA4D\uC73C\uB85C \uB5A8\uC5B4\uC84C\uB294\uB370...
      \uBC24\uC774\uC796\uC544?"
    portrait: {fileID: 0}
  greetLines:
  - speaker: "\uC2A4\uD551\uD06C\uC2A4"
    text: "\uBAA8\uB798\uB97C \uD5E4\uCE58\uACE0 \uB0B4\uAC8C \uC628 \uC790\uC5EC.
      \uB098\uB294 \uC9C0\uD3C9\uC120\uC758 \uD638\uB8E8\uC2A4, \uC774 \uC2E0\uC804\uC758
      \uBB38\uC9C0\uAE30\uB2E4."
    portrait: {fileID: 0}
  - speaker: "\uB098"
    text: "\uC2A4, \uC2A4\uD551\uD06C\uC2A4\uAC00... \uB9D0\uC744...?!"
    portrait: {fileID: 0}
  - speaker: "\uC2A4\uD551\uD06C\uC2A4"
    text: "\uBAA8\uB798\uAC00 \uB098\uB97C \uC0BC\uD0A4\uACE0 \uC788\uB2E4. \uB0B4
      \uBC1C\uC744 \uB36E\uC740 \uBAA8\uB798\uB97C \uAC77\uC5B4\uB0B4\uB77C. \uADF8\uB7EC\uBA74
      \uB098\uB3C4 \uB108\uC5D0\uAC8C \uBCF4\uB2F5\uD558\uB9AC\uB77C."
    portrait: {fileID: 0}
