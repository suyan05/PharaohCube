  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 45428056cbba8124abe8fef5ef445864, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HallTempDirector
  cube: {fileID: 1736150436}
  brazier: {fileID: 1370465017}
  rack: {fileID: 991620074}
  brazierInspect: {fileID: 1370465014}
  door: {fileID: 189949703}
  arrivePoint: {x: 9, y: 0.8}
  walkPoint: {x: 9, y: 3}
  introFlag: F_HALL_TEMP_INTRO
  objRack: "\uD683\uBD88 \uAC78\uC774\uC5D0\uC11C \uD683\uBD88\uC744 \uC9D1\uC790"
  objBrazier: "\uD654\uB85C\uC5D0 \uD683\uBD88\uC744 \uB300\uACE0 \uBD88\uC744 \uBD99\uC774\uC790"
  objDoor: "\uBD81\uCABD \uBB38\uC73C\uB85C \uB77C\uC758 \uC2E0\uC804\uC5D0 \uB4E4\uC5B4\uAC00\uC790"
  lines:
    title: "\uC911\uC559 \uD640"
    subtitle: "\uC5EC\uC12F \uC2E0\uC758 \uC2E0\uC804"
    arrive:
    - speaker: "\uB098"
      text: "\uACC4\uB2E8 \uC544\uB798\uC5D0... \uC774\uB7F0 \uACF3\uC774 \uC788\uC5C8\uB2E4\uB2C8."
      portrait: {fileID: 0}
    - speaker: "\uB098"
      text: "\uAC00\uC6B4\uB370 \uC788\uB294 \uAC74... \uD050\uBE0C?"
      portrait: {fileID: 0}
    voice:
    - speaker: ???
      text: "\uB2E4\uC74C \uC2E0\uC804\uC5D0\uB294 \uBE5B\uC774 \uB4E4\uC9C0 \uC54A\uB294\uB2E4."
      portrait: {fileID: 0}
    - speaker: ???
      text: "\uB77C\uAC00 \uB0B4\uC5B4\uC900 \uC774 \uBD88\uC744 \uAC00\uC838\uAC00\uB77C."
      portrait: {fileID: 0}
    needTorch:
    - speaker: "\uB098"
      text: "\uBD88\uC744 \uC62E\uACA8 \uB2F4\uC744 \uAC8C \uD544\uC694\uD574. \uC800
        \uAC78\uC774\uC5D0 \uD683\uBD88\uC774 \uC788\uB2E4."
      portrait: {fileID: 0}
    gotTorch:
    - speaker: "\uB098"
      text: "\uB410\uB2E4. \uC774 \uBD88\uC774\uBA74 \uC5B4\uB450\uC6B4 \uACF3\uB3C4
        \uAC08 \uC218 \uC788\uACA0\uC5B4."
      portrait: {fileID: 0}
    toDoor:
    - speaker: "\uB098"
      text: "\uBD81\uCABD \uBB38 \uB108\uBA38\uAC00 \uCCAB \uBC88\uC9F8 \uC2E0\uC804...
        \uD0DC\uC591\uC758 \uC2E0, \uB77C."
      portrait: {fileID: 0}
