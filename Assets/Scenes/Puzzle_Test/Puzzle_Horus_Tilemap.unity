  darkLines:
  - speaker: "\uB098"
    text: "\uB108\uBB34 \uC5B4\uB450\uC6CC\uC11C \uAE00\uC528\uAC00 \uBCF4\uC774\uC9C0
      \uC54A\uB294\uB2E4. \uC606\uC758 \uBCC4 \uD683\uBD88\uBD80\uD130 \uBC1D\uD788\uC790."
    portrait: {fileID: 0}
  lensDecodeAtNight: 0
  requiredFlag: F_HO_CHART_2
  notYetLines:
  - speaker: "\uB098"
    text: "\uAE00\uC790\uAC00 \uC544\uC9C1 \uD76C\uBBF8\uD558\uAC8C \uC7A0\uB4E4\uC5B4
      \uC788\uB2E4... \uC9C0\uAE08\uC740 \uC77D\uD788\uC9C0 \uC54A\uC544. \uB2E4\uB978
      \uACF3\uBD80\uD130 \uAC00 \uBCF4\uC790."
    portrait: {fileID: 0}
