  objectId: HO_MYTH_BOOK
  promptText: "\uC2E0\uD654 \uCC45 \uC77D\uAE30"
  holdPromptText: "\uAE38\uAC8C \uB20C\uB7EC \uD138\uAE30"
  requiredFlag: 
  lockedLines: []
  requiredTool: 
  missingToolLines:
  - speaker: 
    text: "\uB3C4\uAD6C\uAC00 \uC788\uC5B4\uC57C \uD560 \uAC83 \uAC19\uB2E4."
    portrait: {fileID: 0}
  holdSeconds: 0
  holdDecayRate: 0.5
  holdRange: 1.6
  targetRenderer: {fileID: 0}
  holdStageSprites: []
  doneSprite: {fileID: 0}
  grantItems: []
  lines:
  - speaker: 
    text: "\uC2E0\uD654 \uCC45 - \uD638\uB8E8\uC2A4\uC640 \uC138\uD2B8"
    portrait: {fileID: 0}
  - speaker: 
    text: "\uC624\uC2DC\uB9AC\uC2A4\uB294 \uC774\uC9D1\uD2B8\uB97C \uB2E4\uC2A4\uB9B0
      \uC120\uD55C \uC655\uC774\uC5C8\uB2E4. \uC624\uC2DC\uB9AC\uC2A4\uC640 \uC774\uC2DC\uC2A4
      \uC0AC\uC774\uC5D0\uC11C \uC544\uB4E4 \uD638\uB8E8\uC2A4\uAC00 \uD0DC\uC5B4\uB0AC\uB2E4."
    portrait: {fileID: 0}
  - speaker: 
    text: "\uB3D9\uC0DD \uC138\uD2B8\uB294 \uD615 \uC624\uC2DC\uB9AC\uC2A4\uB97C
      \uC8FD\uC774\uACE0 \uC655\uC88C\uB97C \uBE7C\uC557\uC558\uB2E4."
    portrait: {fileID: 0}
  - speaker: 
    text: "\uD638\uB8E8\uC2A4\uB294 \uC655\uC88C\uB97C \uB450\uACE0 \uC138\uD2B8\uC640
      \uC2F8\uC6B0\uB2E4 \uD55C\uCABD \uB208\uC744 \uC783\uC5C8\uACE0, \uD1A0\uD2B8\uAC00
      \uADF8 \uB208\uC744 \uACE0\uCCD0 \uC8FC\uC5C8\uB2E4. \uACE0\uCE5C \uB208\uC774
      \uC6B0\uC790\uD2B8\uB2E4."
    portrait: {fileID: 0}
  setFlags: []
  onceOnly: 0
  afterDoneLines:
  - speaker: 
    text: "\uC2E0\uD654 \uCC45 - \uD638\uB8E8\uC2A4\uC640 \uC138\uD2B8"
    portrait: {fileID: 0}
  - speaker: 
    text: "\uC624\uC2DC\uB9AC\uC2A4\uB294 \uC774\uC9D1\uD2B8\uB97C \uB2E4\uC2A4\uB9B0
      \uC120\uD55C \uC655\uC774\uC5C8\uB2E4. \uC624\uC2DC\uB9AC\uC2A4\uC640 \uC774\uC2DC\uC2A4
      \uC0AC\uC774\uC5D0\uC11C \uC544\uB4E4 \uD638\uB8E8\uC2A4\uAC00 \uD0DC\uC5B4\uB0AC\uB2E4."
    portrait: {fileID: 0}
  - speaker: 
    text: "\uB3D9\uC0DD \uC138\uD2B8\uB294 \uD615 \uC624\uC2DC\uB9AC\uC2A4\uB97C
