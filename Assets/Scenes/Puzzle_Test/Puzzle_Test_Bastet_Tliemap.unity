--- !u!114 &993810601
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 993810599}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 91bc5c9fc28eab748930152bd8ed253c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BastetGoddess
  dialogue: {fileID: 911857069}
  newBubble: {fileID: 1265918648}
  bobHeight: 0.08
  bobSpeed: 3
  autoIntro: 1
  autoIntroDelay: 1.2
  introFlag: F_BASTET_GODDESS_INTRO
  mainOpenFlag: F_BASTET_B4_CLEAR
  mainTalkFlag: F_BASTET_GODDESS_MAIN
  mainDoneFlag: F_BASTET_MAIN_DONE
  endTalkFlag: F_BASTET_GODDESS_END
  introLines:
  - portrait: 0
    text: "\uC5B4\uB460 \uC18D\uC744 \uAC78\uC5B4\uC628 \uC790\uC5EC. \uB098\uB294
      \uBC14\uC2A4\uD14C\uD2B8, \uB77C\uC758 \uB208\uC774\uC790 \uBC24\uC744 \uC9C0\uD0A4\uB294
      \uACE0\uC591\uC774\uB2E4."
  - portrait: 0
    text: "\uC774 \uC2E0\uC804\uC758 \uBD88\uC740 \uC2A4\uC2A4\uB85C \uCF1C\uC9C0\uC9C0
      \uC54A\uB294\uB2E4. \uB124 \uC190\uC758 \uBD88\uB85C \uBCBD\uC758 \uD683\uBD88\uC744
      \uAE68\uC6CC\uB77C."
  - portrait: 1
    text: "\uB124 \uAC1C\uC758 \uBC29\uC5D0 \uB098\uC758 \uD754\uC801\uC774 \uC7A0\uB4E4\uC5B4
      \uC788\uB2E4. \uBC1C\uC790\uAD6D, \uB208, \uBAA9\uAC78\uC774, \uBC1C\uD1B1.
      \uBAA8\uB450 \uCC3E\uC544\uC624\uB108\uB77C."
  mainLines:
  - portrait: 1
    text: "\uB124 \uAC1C\uC758 \uD754\uC801\uC774 \uBAA8\uB450 \uB3CC\uC544\uC654\uAD6C\uB098."
  - portrait: 0
    text: "\uBD81\uCABD \uC2E0\uC0C1\uC758 \uBC29\uC73C\uB85C \uAC00\uB77C. \uB0AE\uC5D0\uB294
      \uD574\uB97C \uB530\uB77C \uAC77\uACE0, \uBC24\uC5D0\uB294 \uC9C0\uB098\uC628
      \uAE38\uC744 \uAC70\uC2AC\uB7EC \uB3CC\uC544\uC624\uB108\uB77C."
  - portrait: 2
    text: "\uBC24\uC774 \uC624\uBA74 \uB098\uC758 \uB208\uC740 \uB2EC\uBE5B\uC774
      \uB41C\uB2E4. \uB9C8\uC9C0\uB9C9\uC5D0 \uBE5B\uB09C \uB208\uC744 \uC78A\uC9C0
      \uB9C8\uB77C."
  endLines:
  - portrait: 1
    text: "\uD574\uC640 \uB2EC\uC744 \uBAA8\uB450 \uAE30\uC5B5\uD558\uB294\uAD6C\uB098.
      \uB108\uB294 \uB098\uC758 \uC2DC\uD5D8\uC744 \uD1B5\uACFC\uD588\uB2E4."
  - portrait: 0
    text: "\uADF8 \uD615\uD310\uC744 \uAC00\uC838\uAC00\uB77C. \uD050\uBE0C\uC758
      \uD55C \uBA74\uC774 \uB420 \uAC83\uC774\uB2E4."
  - portrait: 0
    text: "\uB2E4\uC74C\uC740 \uC2EC\uD310\uC758 \uC2E0\uC804. \uC544\uB204\uBE44\uC2A4\uAC00
      \uB124 \uB9C8\uC74C\uC758 \uBB34\uAC8C\uB97C \uB2EC\uC544 \uBCFC \uAC83\uC774\uB2E4."
  progressHints:
