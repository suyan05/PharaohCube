  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e1e94fb9f75849942998f687196d74f0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LeverPuzzleReal
  slotCount: 5
  slotSpacing: 70
  heartSlot: 3
  heartMass: 6
  weightMass: 3
  maxWeights: 3
  scrollId: SCROLL_ANUBIS_3
  variants:
  - heartSlot: 3
    scrollText: 
  - heartSlot: 4
    scrollText: "\uC544\uB204\uBE44\uC2A4\uC758 \uC9C0\uB81B\uB300\uB294 \uBB34\uAC8C\uB9CC\uC73C\uB85C
      \uAE30\uC6B8\uC9C0 \uC54A\uB294\uB2E4.\n\uCD95\uC5D0\uC11C \uBA40\uC5B4\uC9C8\uC218\uB85D
      \uAC19\uC740 \uBB34\uAC8C\uB3C4\n\uB354 \uD070 \uD798\uC73C\uB85C \uB0B4\uB9AC\uB204\uB978\uB2E4.\n(\uBB34\uAC8C
      \xD7 \uCD95\uC5D0\uC11C\uC758 \uAC70\uB9AC)\uAC00 \uC591\uCABD\uC5D0\uC11C
      \uAC19\uC744 \uB54C\n\uBE44\uB85C\uC18C \uC9C0\uB81B\uB300\uB294 \uD3C9\uD615\uC744
      \uC774\uB8EC\uB2E4.\n\n\uB9DD\uC790\uC758 \uC2EC\uC7A5\uC740 \uC67C\uCABD \uB124
      \uBC88\uC9F8 \uB208\uAE08\uC5D0 \uAC78\uB824 \uC788\uB2E4.\n\uADF8 \uC2EC\uC7A5\uC758
      \uBB34\uAC8C\uB294\n\uD751\uC694\uC11D \uCD94 \uB450 \uAC1C\uB97C \uD569\uCE5C
      \uAC83\uACFC \uAC19\uB2E4.\n\n\uD751\uC694\uC11D \uCD94\uB97C \uBA87 \uAC1C,\n\uBA87
      \uBC88\uC9F8 \uB208\uAE08\uC5D0 \uAC78\uC5B4\uC57C \uD558\uACA0\uB294\uAC00."
  - heartSlot: 2
    scrollText: "\uC544\uB204\uBE44\uC2A4\uC758 \uC9C0\uB81B\uB300\uB294 \uBB34\uAC8C\uB9CC\uC73C\uB85C
      \uAE30\uC6B8\uC9C0 \uC54A\uB294\uB2E4.\n\uCD95\uC5D0\uC11C \uBA40\uC5B4\uC9C8\uC218\uB85D
      \uAC19\uC740 \uBB34\uAC8C\uB3C4\n\uB354 \uD070 \uD798\uC73C\uB85C \uB0B4\uB9AC\uB204\uB978\uB2E4.\n(\uBB34\uAC8C
      \xD7 \uCD95\uC5D0\uC11C\uC758 \uAC70\uB9AC)\uAC00 \uC591\uCABD\uC5D0\uC11C
      \uAC19\uC744 \uB54C\n\uBE44\uB85C\uC18C \uC9C0\uB81B\uB300\uB294 \uD3C9\uD615\uC744
      \uC774\uB8EC\uB2E4.\n\n\uB9DD\uC790\uC758 \uC2EC\uC7A5\uC740 \uC67C\uCABD \uB450
      \uBC88\uC9F8 \uB208\uAE08\uC5D0 \uAC78\uB824 \uC788\uB2E4.\n\uADF8 \uC2EC\uC7A5\uC758
      \uBB34\uAC8C\uB294\n\uD751\uC694\uC11D \uCD94 \uB450 \uAC1C\uB97C \uD569\uCE5C
      \uAC83\uACFC \uAC19\uB2E4.\n\n\uD751\uC694\uC11D \uCD94\uB97C \uBA87 \uAC1C,\n\uBA87
      \uBC88\uC9F8 \uB208\uAE08\uC5D0 \uAC78\uC5B4\uC57C \uD558\uACA0\uB294\uAC00."
  clueIndex: 2
  clueText: "\uB9DD\uC790\uC758 \uC2EC\uC7A5(H)\uC740 \uBC24\uC758 \uD751\uC694\uC11D
    \uCD94(D) \uB450 \uAC1C\uC758 \uBB34\uAC8C\uC640 \uC815\uD655\uD788 \uAC19\uB3C4\uB2E4.
    (H = 2D)"
  rewardItemId: ITEM_ANUBIS_OBSIDIAN
  clearMessage: "\uC9C0\uB81B\uB300\uAC00 \uC644\uBCBD\uD55C \uC218\uD3C9\uC744 \uC774\uB8E8\uC5C8\uC2B5\uB2C8\uB2E4!\n\uC0AC\uC790\uC758
    \uC11C\uC5D0 \uC138 \uBC88\uC9F8 \uBE44\uBB38\uC774 \uAE30\uB85D\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
