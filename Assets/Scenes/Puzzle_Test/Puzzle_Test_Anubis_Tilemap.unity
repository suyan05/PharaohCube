--- !u!114 &308843109
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 308843107}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: da6fcf07422757b4a83e9fed82b25421, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GearPuzzleReal
  teethOptions: 0c0000001800000024000000
  sizeNames:
  - "\uC791\uC740 \uBC14\uD034"
  - "\uC911\uAC04 \uBC14\uD034"
  - "\uD070 \uBC14\uD034"
  targetAdvantage: 6
  startGearIndex: 000000000000000000000000
  scrollId: SCROLL_ANUBIS_2
  variants:
  - targetAdvantage: 6
    scrollText: 
  - targetAdvantage: 4
    scrollText: "\uD0DC\uC5FD\uC758 \uD798\uC740 \uC624\uC9C1 \uCCAB \uBC14\uD034\uC640
      \uB9C8\uC9C0\uB9C9 \uBC14\uD034\uAC00 \uC815\uD55C\uB2E4.\n\uB9C8\uC9C0\uB9C9
      \uBC14\uD034\uC758 \uC774\uAC00 \uCCAB \uBC14\uD034\uBCF4\uB2E4 \uB9CE\uC744\uC218\uB85D,\n\uD798\uC740
      \uADF8 \uBE44\uC728\uB9CC\uD07C \uCEE4\uC9C4\uB2E4.\n\uAC00\uC6B4\uB370 \uBC14\uD034\uB294
      \uB3C4\uB294 \uBC29\uD5A5\uB9CC \uBC14\uAFC0 \uBFD0,\n\uD798\uC744 \uB354\uD558\uC9C0\uB3C4
      \uBE7C\uC9C0\uB3C4 \uC54A\uB294\uB2E4.\n\n\uC791\uC740 \uBC14\uD034\uB294 \uC5F4\uB450
      \uAC1C\uC758 \uC774,\n\uC911\uAC04 \uBC14\uD034\uB294 \uC2A4\uBB3C\uB124 \uAC1C,
      \uD070 \uBC14\uD034\uB294 \uC11C\uB978\uC5EC\uC12F \uAC1C\uC758 \uC774\uB97C
      \uAC00\uC84C\uB2E4.\n\n\uACE0\uC815 \uB3C4\uB974\uB798\uB294 \uBC29\uD5A5\uB9CC
      \uBC14\uAFB8\uACE0,\n\uC6C0\uC9C1 \uB3C4\uB974\uB798\uB294 \uD558\uB098\uB9C8\uB2E4
      \uD798\uC744 \uB450 \uBC30\uB85C \uB9CC\uB4E0\uB2E4.\n\n\uD55C \uADFC\uC758
      \uCD94\uB85C \uB124 \uADFC\uC758 \uC11D\uAD00\uC744 \uB4E4\uC5B4 \uC62C\uB824\uB77C.\n\uD798\uC774
      \uBAA8\uC790\uB77C\uB3C4, \uB118\uCCD0\uB3C4 \uC904\uC740 \uBC84\uD2F0\uC9C0
      \uBABB\uD55C\uB2E4."
  - targetAdvantage: 8
    scrollText: "\uD0DC\uC5FD\uC758 \uD798\uC740 \uC624\uC9C1 \uCCAB \uBC14\uD034\uC640
      \uB9C8\uC9C0\uB9C9 \uBC14\uD034\uAC00 \uC815\uD55C\uB2E4.\n\uB9C8\uC9C0\uB9C9
      \uBC14\uD034\uC758 \uC774\uAC00 \uCCAB \uBC14\uD034\uBCF4\uB2E4 \uB9CE\uC744\uC218\uB85D,\n\uD798\uC740
      \uADF8 \uBE44\uC728\uB9CC\uD07C \uCEE4\uC9C4\uB2E4.\n\uAC00\uC6B4\uB370 \uBC14\uD034\uB294
      \uB3C4\uB294 \uBC29\uD5A5\uB9CC \uBC14\uAFC0 \uBFD0,\n\uD798\uC744 \uB354\uD558\uC9C0\uB3C4
      \uBE7C\uC9C0\uB3C4 \uC54A\uB294\uB2E4.\n\n\uC791\uC740 \uBC14\uD034\uB294 \uC5F4\uB450
      \uAC1C\uC758 \uC774,\n\uC911\uAC04 \uBC14\uD034\uB294 \uC2A4\uBB3C\uB124 \uAC1C,
      \uD070 \uBC14\uD034\uB294 \uC11C\uB978\uC5EC\uC12F \uAC1C\uC758 \uC774\uB97C
      \uAC00\uC84C\uB2E4.\n\n\uACE0\uC815 \uB3C4\uB974\uB798\uB294 \uBC29\uD5A5\uB9CC
      \uBC14\uAFB8\uACE0,\n\uC6C0\uC9C1 \uB3C4\uB974\uB798\uB294 \uD558\uB098\uB9C8\uB2E4
      \uD798\uC744 \uB450 \uBC30\uB85C \uB9CC\uB4E0\uB2E4.\n\n\uD55C \uADFC\uC758
      \uCD94\uB85C \uC5EC\uB35F \uADFC\uC758 \uC11D\uAD00\uC744 \uB4E4\uC5B4 \uC62C\uB824\uB77C.\n\uD798\uC774
      \uBAA8\uC790\uB77C\uB3C4, \uB118\uCCD0\uB3C4 \uC904\uC740 \uBC84\uD2F0\uC9C0
      \uBABB\uD55C\uB2E4."
  clueIndex: 1
  clueText: "\uCCAD\uB3D9\uC758 \uADF8\uB987(B)\uACFC \uD759(C)\uC758 \uBB34\uAC8C
    \uD569\uC740, \uBC24\uC758 \uD751\uC694\uC11D(D)\uACFC \uD669\uAE08(A)\uC758
    \uD569\uBCF4\uB2E4 \uAC00\uC7A5 \uC791\uC740 \uBB34\uAC8C \uB2E8\uC704(1kg)\uB9CC\uD07C
    \uBB34\uAC81\uB3C4\uB2E4. ((B + C) - (D + A) = 1)"
  rewardItemId: ITEM_ANUBIS_CLAY_POT
  clearMessage: "\uC11D\uAD00\uC774 \uCC9C\uCC9C\uD788 \uB5A0\uC62C\uB790\uC2B5\uB2C8\uB2E4!\n\uC0AC\uC790\uC758
    \uC11C\uC5D0 \uB450 \uBC88\uC9F8 \uBE44\uBB38\uC774 \uAE30\uB85D\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  gearTransforms:
  - {fileID: 192646283}
  - {fileID: 752781586}
  - {fileID: 741872359}
  gearLabels:
  - {fileID: 1213155430}
