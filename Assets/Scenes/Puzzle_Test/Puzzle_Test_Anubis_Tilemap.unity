  startAmounts: 0c000000000000000000000000000000
  goalAmounts: 04000000040000000400000000000000
  scrollId: SCROLL_ANUBIS_1
  variants:
  - capacities: 0c000000080000000500000003000000
    startAmounts: 0c000000000000000000000000000000
    goalAmounts: 04000000040000000400000000000000
    scrollText: 
  - capacities: 09000000070000000400000002000000
    startAmounts: 09000000000000000000000000000000
    goalAmounts: 03000000030000000300000000000000
    scrollText: "\uB098\uD2B8\uB860\uC758 \uBAA8\uB798\uB294 \uC624\uC9C1 \uD56D\uC544\uB9AC\uC5D0\uC11C
      \uD56D\uC544\uB9AC\uB85C\uB9CC \uC62E\uACA8\uC9C4\uB2E4.\n\uD55C \uBC88 \uBD93\uAE30
      \uC2DC\uC791\uD558\uBA74, \uBC1B\uB294 \uD56D\uC544\uB9AC\uAC00 \uAC00\uB4DD
      \uCC28\uAC70\uB098\n\uBD93\uB294 \uD56D\uC544\uB9AC\uAC00 \uBE4C \uB54C\uAE4C\uC9C0
      \uBA48\uCD94\uC9C0 \uC54A\uB294\uB2E4.\n\n\uCCAB\uC9F8 \uD56D\uC544\uB9AC\uB294
      \uC544\uD649 \uB418, \uB458\uC9F8\uB294 \uC77C\uACF1 \uB418,\n\uC14B\uC9F8\uB294
      \uB124 \uB418, \uB137\uC9F8\uB294 \uB450 \uB418\uB97C \uB2F4\uB294\uB2E4.\n\n\uBAA8\uB798\uB294
      \uCC98\uC74C\uC5D0 \uCCAB\uC9F8 \uD56D\uC544\uB9AC\uC5D0\uB9CC \uAC00\uB4DD
      \uB2F4\uACA8 \uC788\uC73C\uB2C8,\n\uCCAB\uC9F8\xB7\uB458\uC9F8\xB7\uC14B\uC9F8
      \uD56D\uC544\uB9AC\uC5D0 \uC138 \uB418\uC529 \uB611\uAC19\uC774 \uB098\uB204\uACE0\n\uB9C9\uB0B4\uC778
      \uB137\uC9F8 \uD56D\uC544\uB9AC\uB294 \uBE44\uC6CC \uB450\uC5B4\uB77C."
  - capacities: 0a000000070000000400000003000000
    startAmounts: 0a000000000000000000000000000000
    goalAmounts: 06000000020000000200000000000000
    scrollText: "\uB098\uD2B8\uB860\uC758 \uBAA8\uB798\uB294 \uC624\uC9C1 \uD56D\uC544\uB9AC\uC5D0\uC11C
      \uD56D\uC544\uB9AC\uB85C\uB9CC \uC62E\uACA8\uC9C4\uB2E4.\n\uD55C \uBC88 \uBD93\uAE30
      \uC2DC\uC791\uD558\uBA74, \uBC1B\uB294 \uD56D\uC544\uB9AC\uAC00 \uAC00\uB4DD
      \uCC28\uAC70\uB098\n\uBD93\uB294 \uD56D\uC544\uB9AC\uAC00 \uBE4C \uB54C\uAE4C\uC9C0
      \uBA48\uCD94\uC9C0 \uC54A\uB294\uB2E4.\n\n\uCCAB\uC9F8 \uD56D\uC544\uB9AC\uB294
      \uC5F4 \uB418, \uB458\uC9F8\uB294 \uC77C\uACF1 \uB418,\n\uC14B\uC9F8\uB294
      \uB124 \uB418, \uB137\uC9F8\uB294 \uC138 \uB418\uB97C \uB2F4\uB294\uB2E4.\n\n\uBAA8\uB798\uB294
      \uCC98\uC74C\uC5D0 \uCCAB\uC9F8 \uD56D\uC544\uB9AC\uC5D0\uB9CC \uAC00\uB4DD
      \uB2F4\uACA8 \uC788\uC73C\uB2C8,\n\uCCAB\uC9F8 \uD56D\uC544\uB9AC\uC5D0\uB294
      \uC5EC\uC12F \uB418\uB97C \uB0A8\uAE30\uACE0\n\uB458\uC9F8\uC640 \uC14B\uC9F8\uC5D0
      \uB450 \uB418\uC529 \uB098\uB204\uBA70\n\uB9C9\uB0B4\uC778 \uB137\uC9F8 \uD56D\uC544\uB9AC\uB294
      \uBE44\uC6CC \uB450\uC5B4\uB77C."
  clueIndex: 0
  clueText: "\uAC00\uC7A5 \uBE44\uCC9C\uD55C \uD759\uC758 \uB2E8\uC9C0(C)\uC5D0 \uD0DC\uC591\uC758
    \uD669\uAE08(A)\uC744 \uB354\uD574\uC57C\uB9CC \uC2EC\uC7A5(H)\uC758 \uBB34\uAC8C\uB97C
    \uC5BB\uC73C\uB9AC\uB77C. (C + A = H)"
