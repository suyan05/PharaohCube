--- !u!114 &872000988
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 872000984}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7a8a6293776a45e4c80d286039b41327, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnubisShrine
  dialogue: {fileID: 1917068873}
  penalty: {fileID: 477033303}
  newBubble: {fileID: 174022780}
  bobHeight: 0.08
  bobSpeed: 3
  prompt: "E: \uC544\uB204\uBE44\uC2A4 \uC2E0\uC0C1 \uC870\uC0AC"
  firstTalkedFlag: F_ANUBIS_SHRINE_FIRST_TALKED
  mainClearFlag: F_ANUBIS_MAIN_DONE
  endTalkedFlag: F_ANUBIS_SHRINE_END_TALKED
  trialItems:
  - ITEM_ANUBIS_GOLD_JAR
  - ITEM_ANUBIS_CLAY_POT
  - ITEM_ANUBIS_OBSIDIAN
  - ITEM_ANUBIS_BRONZE_BOWL
  introLines:
  - portrait: 0
    text: "\uB9DD\uC790\uC5EC, \uB450\uC544\uD2B8\uC758 \uC2EC\uD310\uC815\uC5D0
      \uC628 \uAC83\uC744 \uD658\uC601\uD55C\uB2E4. \uB098\uB294 \uC800\uC6B8\uC744
      \uC9C0\uD0A4\uB294 \uC790, \uC544\uB204\uBE44\uC2A4\uB2E4."
  - portrait: 2
    text: "\uB124 \uC2EC\uC7A5\uC740 \uC9C4\uC2E4\uC758 \uAE43\uD138\uACFC \uD568\uAED8
      \uC800\uC6B8\uC5D0 \uC624\uB97C \uAC83\uC774\uB2E4. \uADF8 \uC804\uC5D0 \uB124
      \uAC1C\uC758 \uC2DC\uD5D8\uC744 \uD1B5\uACFC\uD558\uB77C."
  - portrait: 0
    text: "\uBC14\uB2E5\uC5D0 \uD769\uC5B4\uC9C4 \uC591\uD53C\uC9C0 \uC870\uAC01\uC744
      \uBAA8\uC544\uB77C. \uC870\uAC01\uC774 \uBAA8\uC77C\uC218\uB85D \uC2DC\uD5D8\uC758
      \uADDC\uCE59\uC774 \uB4DC\uB7EC\uB09C\uB2E4."
  - portrait: 0
    text: "\uC2DC\uD5D8\uB9C8\uB2E4 \uBCF4\uBB3C \uD558\uB098\uC640 \uC0AC\uC790\uC758
      \uC11C \uBE44\uBB38 \uD558\uB098\uB97C \uC5BB\uB294\uB2E4. \uBE44\uBB38\uC740
      \uBCF4\uBB3C\uC758 \uBB34\uAC8C\uB97C \uB9D0\uD574 \uC904 \uAC83\uC774\uB2E4."
  progressLines:
  - portrait: 0
    text: "\uBD88\uC774 \uCF1C\uC9C4 \uAD6C\uC5ED\uC758 \uC81C\uB2E8\uC73C\uB85C
      \uAC00\uB77C. \uC2DC\uD5D8\uC744 \uD558\uB098 \uD1B5\uACFC\uD560 \uB54C\uB9C8\uB2E4
      \uB2E4\uC74C \uAE38\uC774 \uC5F4\uB9B0\uB2E4."
  - portrait: 0
    text: "\uB9C9\uD788\uBA74 \uC2DC\uD5D8 \uD654\uBA74 \uC624\uB978\uCABD \uC704\uC758
      \uC6B0\uC81C\uD2B8\uC758 \uB208\uC744 \uB20C\uB7EC\uB77C. \uAE38\uC744 \uC870\uAE08
      \uBE44\uCDB0 \uC904 \uAC83\uC774\uB2E4."
  readyLines:
  - portrait: 1
    text: "\uB124 \uAC1C\uC758 \uBCF4\uBB3C\uC744 \uBAA8\uB450 \uBAA8\uC558\uAD6C\uB098."
  - portrait: 2
    text: "\uB0A8\uCABD \uC2EC\uD310\uC758 \uC800\uC6B8\uB85C \uAC00\uB77C. \uAE43\uD138\uC758
      \uBB34\uAC8C\uB294 \uC77C\uACF1. \uBE44\uBB38\uC73C\uB85C \uAC01 \uBCF4\uBB3C\uC758
      \uBB34\uAC8C\uB97C \uBC1D\uD600\uB77C."
  - portrait: 2
    text: "\uAE30\uD68C\uB294 \uD55C \uBC88\uBFD0\uC774\uB2E4. \uC800\uC6B8\uC774
      \uAE30\uC6B8\uBA74 \uC554\uBB34\uD2B8\uAC00 \uBCF4\uBB3C\uC744 \uC0BC\uD0AC
      \uAC83\uC774\uB2E4."
  penaltyLines:
  - portrait: 2
    text: "\uC800\uC6B8\uC774 \uAE30\uC6B8\uC5C8\uACE0, \uC554\uBB34\uD2B8\uAC00
      \uBCF4\uBB3C\uC744 \uC0BC\uCF30\uB2E4."
  - portrait: 0
    text: "\uD5C8\uB098 \uC0AC\uC790\uC758 \uC11C\uC5D0 \uC0C8\uAE34 \uBE44\uBB38\uC740
      \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uC558\uB2E4. \uC2DC\uD5D8\uC758 \uBAA8\uC2B5\uC740
      \uBC14\uB00C\uC5C8\uC73C\uB2C8 \uCC98\uC74C\uBD80\uD130 \uB2E4\uC2DC \uAC78\uC5B4\uB77C."
  clearedLines:
  - portrait: 1
    text: "\uC2EC\uC7A5\uACFC \uAE43\uD138\uC774 \uD3C9\uD615\uC744 \uC774\uB8E8\uC5C8\uB2E4.
      \uB108\uC758 \uC601\uD63C\uC740 \uC9C4\uC2E4\uD558\uB2E4."
  - portrait: 1
    text: "\uC544\uC54C\uB8E8\uC758 \uAC08\uB300\uBC2D\uC73C\uB85C \uAC00\uB294 \uAE38\uC774
      \uC5F4\uB838\uB2E4. \uAC00\uAC70\uB77C, \uC758\uB85C\uC6B4 \uC790\uC5EC."
  progressCountFormat: "\uC9C0\uAE08\uAE4C\uC9C0 \uBAA8\uC740 \uC2DC\uD5D8\uC758
    \uBCF4\uBB3C: {0} / {1}"
