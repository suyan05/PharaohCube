      \uC18C\uBCA0\uD06C\uB294 \uB9C8\uC9C0\uB9C9 \uBC94\uB78C\uC758 \uBB3C\uC744
      \uC774 \uC2E0\uC804\uC5D0 \uAC00\uB46C \uB450\uC5C8\uB2E4."
    - "\uBB3C\uC774 \uCC2C \uC2E0\uC804\uC744 \uC9C0\uB098 \uC18C\uBCA0\uD06C\uC758
      \uC785\uC73C\uB85C \uB4E4\uC5B4\uAC00\uC790."
  - board: {fileID: 561101775}
    lines:
    - "\uC18C\uBCA0\uD06C\uC758 \uC785\uC744 \uC9C0\uB098 \uBB3C\uC774 \uBE60\uC9C4
      \uC544\uB798\uCE35\uC73C\uB85C \uB0B4\uB824\uC654\uB2E4."
    - "\uC545\uC5B4 \uBB34\uB364\uC758 \uBBF8\uAD81\u2026 \uC218\uBA74\uC5D0 \uBE44\uCE5C
      \uBC18\uB300\uD3B8 \uBC29\uC744 \uC624\uAC00\uC57C \uD55C\uB2E4."
  - board: {fileID: 1265227566}
    lines:
    - "\uBBF8\uAD81 \uB05D, \uC18C\uC6A9\uB3CC\uC774 \uC12C\uB4E4\uC774 \uC18C\uBCA0\uD06C-\uB77C\uC758
      \uD0D1\uC744 \uB458\uB7EC\uC2F8\uACE0 \uC788\uB2E4."
    - "\uC12C\uC744 \uB3CC\uB824 \uAE38\uC744 \uC774\uC5B4 \uC81C\uB2E8\uAE4C\uC9C0
      \uAC00\uC790."
  plateItemId: PLATE_SOBEK
  playerInventoryFace: 4
  ending: {fileID: 1350230036}
  hubSceneName: Sobek_Hub
  fadeTime: 0.8
  altarLines:
  - "\uB098"
  - "\uC18C\uBCA0\uD06C-\uB77C\uC758 \uD0DC\uC591 \uC6D0\uBC18\uC774 \uBE5B\uB09C\uB2E4\u2026"
  - "\uC18C\uBCA0\uD06C"
  - "\uC544\uD3A9\uC774 \uAC15\uC744 \uB9C8\uC2DC\uAE30 \uC804, \uB098\uB294 \uB9C8\uC9C0\uB9C9
    \uBC94\uB78C\uC744 \uC774 \uC2E0\uC804\uC5D0 \uAC00\uB46C \uB450\uC5C8\uB2E4."
  - "\uC18C\uBCA0\uD06C"
  - "\uBB3C\uC744 \uB2E4\uC2A4\uB9B4 \uC904 \uC544\uB294\uAD6C\uB098. \uAC00\uB454
    \uBB3C\uC744 \uAC15\uC73C\uB85C \uB3CC\uB824\uBCF4\uB0B4\uACA0\uB2E4."
  - "\uC18C\uBCA0\uD06C"
  - "\uADF8 \uD615\uD310\uC744 \uAC00\uC838\uAC00\uB77C. \uD050\uBE0C\uC758 \uB2E4\uC12F
    \uBC88\uC9F8 \uBA74\uC774 \uB420 \uAC83\uC774\uB2E4."
  - "\uC18C\uBCA0\uD06C"
  - "\uBB3C\uC774 \uBE60\uC9C4 \uC790\uB9AC\uC5D0 \uAC15\uC758 \uBE44\uBC00\uC774
    \uB0A8\uB294\uB2E4. \uB098\uC758 \uC545\uC5B4\uAC00 \uAE38\uC744 \uC54C\uB824
    \uC8FC\uB9AC\uB77C."
  lineTime: 2.8
