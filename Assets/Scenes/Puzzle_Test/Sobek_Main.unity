  zoneA: {fileID: 1710258962}
  zoneB: {fileID: 1211302004}
  plateItemId: PLATE_SOBEK
  playerInventoryFace: 4
  hubSceneName: Sobek_Hub
  fadeTime: 0.8
  introLines:
  - "\uC544\uD3A9\uC774 \uC800\uC2B9\uC758 \uAC15\uC744 \uC0BC\uD0A4\uAE30 \uC804,
    \uC18C\uBCA0\uD06C\uB294 \uB9C8\uC9C0\uB9C9 \uBC94\uB78C\uC758 \uBB3C\uC744 \uC774
    \uC2E0\uC804\uC5D0 \uAC00\uB46C \uB450\uC5C8\uB2E4."
  - "\uBB3C\uC774 \uCC2C \uC2E0\uC804\uC744 \uC9C0\uB098 \uC18C\uBCA0\uD06C\uC758
    \uC785\uC73C\uB85C \uB4E4\uC5B4\uAC00\uC790."
  gateLines:
  - "\uC18C\uBCA0\uD06C\uC758 \uC785\uC744 \uC9C0\uB098 \uBB3C\uC774 \uBE60\uC9C4
    \uC544\uB798\uCE35\uC73C\uB85C \uB0B4\uB824\uC654\uB2E4."
  - "\uC545\uC5B4 \uBB34\uB364\uC758 \uBBF8\uAD81... \uC81C\uB2E8\uC740 \uBCBD \uB108\uBA38\uC5D0
    \uC788\uB2E4. \uC218\uBA74\uC5D0 \uBE44\uCE5C \uAE38\uC744 \uCC3E\uC790."
  altarLines:
  - "\uC18C\uBCA0\uD06C-\uB77C\uC758 \uD0DC\uC591 \uC6D0\uBC18\uC774 \uBE5B\uB09C\uB2E4."
  - "\"\uBB3C\uC744 \uB2E4\uC2A4\uB9B4 \uC904 \uC544\uB294\uAD6C\uB098. \uAC00\uB46C
    \uB454 \uBB3C\uC744 \uAC15\uC73C\uB85C \uB3CC\uB824\uBCF4\uB0B4\uACA0\uB2E4.\""
  - "\"\uADF8 \uD615\uD310\uC744 \uAC00\uC838\uAC00\uB77C. \uBB3C\uC774 \uBE60\uC9C4
    \uC790\uB9AC\uC5D0 \uC2EC\uD310\uC758 \uBB38\uC774 \uC788\uB2E4.\""
  lineTime: 2.8
