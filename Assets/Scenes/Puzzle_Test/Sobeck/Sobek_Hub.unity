  m_Script: {fileID: 11500000, guid: 491f4d211e151de48860c44b7798a025, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SobekClueSocket
  gaugeRenderer: {fileID: 610054855}
  gaugeSprites:
  - {fileID: 21300000, guid: ea06601adc6772f4385f095546304288, type: 3}
  - {fileID: 21300000, guid: 571c61a2d0d5339469d41f2a624ded5f, type: 3}
  - {fileID: 21300000, guid: d4ade55d7625cf0499508e991a6da045, type: 3}
  - {fileID: 21300000, guid: 1fd572d436f54834aafafd5e07d8cd42, type: 3}
  slab: {fileID: 2061443933}
  stairs: {fileID: 1086375932}
  apep: {fileID: 1683486636}
  reachFlag: F_SOBEK_MAIN_DONE
  underwaterText: "\uBB3C\uC18D\uC5D0 \uB208\uAE08 \uAE30\uB465\uC774 \uC11C \uC788\uB2E4.
    \uBE48 \uB208\uAE08\uC774 \uC14B. \uBB3C\uC774 \uBE60\uC838\uC57C \uB2FF\uACA0\uB2E4."
  missingHints:
  - "\uC804\uC2E4 \uBC14\uB2E5\uC758 \uBC94\uB78C \uBE44\uC11D \uC870\uAC01\uC774
    \uC544\uC9C1 \uB0A8\uC544 \uC788\uB2E4."
  - "\uBB3C \uBE60\uC9C4 \uC218\uB85C \uBC14\uB2E5, \uC816\uC740 \uC9C4\uD759 \uC18D\uC5D0
    \uD558\uB098\uAC00 \uB354 \uC788\uB2E4."
  - "\uC81C\uB2E8 \uC606 \uAC08\uB300 \uB364\uBD88 \uC18D\uC5D0 \uD558\uB098\uAC00
    \uB354 \uC788\uB2E4."
  openLines:
  - "\uB098"
  - "\uB208\uAE08\uC774 \uB2E4 \uCC3C\uB2E4. \uAC15\uC758 \uB192\uC774\uB97C \uB9DE\uCDC4\uB2E4\u2026"
