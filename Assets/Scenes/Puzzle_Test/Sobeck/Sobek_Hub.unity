  showWhenDrained:
  - {fileID: 1733178880}
  - {fileID: 1891657957}
  - {fileID: 1767585654}
  returnSpawn: {fileID: 1662557228}
  drainTime: 3
  cameraFollow: {fileID: 0}
  drainMessage: "\uC2E0\uC804\uC758 \uBB3C\uC774 \uBE60\uC9C4\uB2E4\u2026 \uBB3C
    \uBC11\uC5D0 \uC7A0\uACA8 \uC788\uB358 \uC218\uB85C \uBC14\uB2E5\uACFC \uC544\uB204\uBE44\uC2A4\uC758
    \uBB38\uC774 \uB4DC\uB7EC\uB0AC\uB2E4."
  introLines:
  - "\uCF00\uD504\uB9AC"
  - "\uC5EC\uAE30\uB294 \uC18C\uBCA0\uD06C\uC758 \uC2E0\uC804, \uC170\uB370\uD2B8\uC57C.
    \uC2E0\uC804\uC774 \uC628\uD1B5 \uBB3C\uC5D0 \uC7A0\uACA8 \uC788\uC5B4."
  - "\uB098"
  - "\uBB3C \uC704\uB85C \uC881\uC740 \uAE38\uACFC \uC12C \uB124 \uAC1C\uB9CC \uB5A0
    \uC788\uB2E4\u2026 \uC800 \uD070 \uBB38\uC740 \uC545\uC5B4 \uC785 \uBAA8\uC591\uC774\uB2E4.
    \uD648\uC774 \uB124 \uAC1C \uBE44\uC5B4 \uC788\uB2E4."
  - "\uCF00\uD504\uB9AC"
  - "\uC12C\uB9C8\uB2E4 \uC2DC\uD5D8\uC758 \uBB38\uC774 \uC788\uC5B4. \uB124 \uC2DC\uD5D8\uC744
    \uC9C0\uB098\uBA74 \uBD80\uC801\uC744 \uC904 \uAC70\uC57C. \uBE44\uC11D\uC5D0
    \uD78C\uD2B8\uAC00 \uC0C8\uACA8\uC838 \uC788\uC5B4."
  drainedLines:
  - "\uCF00\uD504\uB9AC"
  - "\uBB3C\uC774 \uBE60\uC84C\uC5B4! \uBB3C\uC18D\uC5D0 \uC7A0\uACA8 \uC788\uB358
    \uBB38\uC774 \uB4DC\uB7EC\uB0AC\uC5B4. \uC800 \uC544\uB798\uAC00 \uC544\uB204\uBE44\uC2A4\uC758
    \uC2E0\uC804\uC774\uC57C."
  - "\uCF00\uD504\uB9AC"
  - "\uC228\uC740 \uAC83\uC744 \uB354 \uCC3E\uACE0 \uC2F6\uC73C\uBA74 \uB458\uB7EC\uBCF4\uACE0,
    \uB2E4 \uB410\uC73C\uBA74 \uADF8 \uBB38\uC73C\uB85C \uB0B4\uB824\uAC00\uC790.
    (\uB0A8\uCABD \uCD9C\uAD6C\uB294 \uC911\uC559 \uD640)"
