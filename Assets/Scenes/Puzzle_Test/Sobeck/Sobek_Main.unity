  stages:
  - board: {fileID: 1373529025}
    lines:
    - "\uC18C\uBCA0\uD06C\uC758 \uC785 \uC548\uCABD, \uBC94\uB78C\uAE30\uC758 \uC2E0\uC804.
      \uBB3C\uACFC \uC12C\uC774 \uD568\uAED8 \uC6C0\uC9C1\uC778\uB2E4."
    - "\uB124 \uC12C\uC5D0\uC11C \uBC30\uC6B4 \uAC83\uC744 \uBAA8\uB450 \uB5A0\uC62C\uB9AC\uC790."
  - board: {fileID: 292472473}
    lines:
    - "\uBB3C\uC774 \uBE60\uC9C4 \uC544\uB798\uCE35, \uAC74\uAE30\uC758 \uBBF8\uAD81.
      \uC545\uC5B4 \uB4F1 \uB2E4\uB9AC\uC640 \uC18C\uC6A9\uB3CC\uC774 \uC12C\uC774
      \uAE38\uC744 \uB9C9\uB294\uB2E4."
  - board: {fileID: 37362701}
    lines:
    - "\uC18C\uBCA0\uD06C-\uB77C\uC758 \uD0D1. \uC12C, \uC545\uC5B4, \uBB3C, \uADF8\uB9AC\uACE0
      \uBCF4\uB294 \uC790\uB9AC\u2026 \uBAA8\uB450 \uB9DE\uC544\uC57C \uC81C\uB2E8\uC5D0
      \uB2FF\uB294\uB2E4."
