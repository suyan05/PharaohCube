  steps:
  - doneFlag: F_RA_SHRINE_FIRST_TALKED
    objective: "\uC911\uC559\uC758 \uB77C\uC758 \uC131\uC18C\uB97C \uC870\uC0AC\uD558\uC790"
  - doneFlag: F_RA_CIRCUIT_1
    objective: "\uC11C\uCABD \uBCBD\uC758 \uBE5B \uD68C\uB85C\uB97C \uC870\uC0AC\uD558\uC790"
  - doneFlag: F_RA_P1_DONE
    objective: "\uC8FC\uD669 \uB80C\uC988\uB97C \uB4E4\uACE0 \uB3D9\uCABD \uADF8\uB9BC\uC790
      \uB2E4\uC774\uC5BC\uB85C \uAC00\uC790"
  - doneFlag: F_RA_CIRCUIT_2
    objective: "\uAC70\uC6B8 \uC870\uAC01 1\uC744 \uB4E4\uACE0 \uD68C\uB85C\uD310
      \uBE48 \uC2AC\uB86F\uC5D0 \uB07C\uC6B0\uC790"
  - doneFlag: F_RA_P3_DONE
    objective: "\uCCAD\uC0C9 \uC548\uB8CC\uB97C \uB4E4\uACE0 \uB0A8\uB3D9\uCABD \uC77C\uC2DD
      \uC11D\uD0C1\uC73C\uB85C \uAC00\uC790"
  - doneFlag: F_RA_CIRCUIT_3
    objective: "\uAC70\uC6B8 \uC870\uAC01 2\uC640 \uD504\uB9AC\uC998\uC744 \uB4E4\uACE0
      \uD68C\uB85C\uD310\uC73C\uB85C \uB3CC\uC544\uAC00\uC790"
  - doneFlag: F_RA_P4_DONE
    objective: "\uD669\uB3D9 \uC5F4\uC1E0\uB97C \uB4E4\uACE0 \uB0A8\uC11C\uCABD \uCE74\uB4DC
      \uBCA4\uCE58\uB85C \uAC00\uC790"
  - doneFlag: F_RA_CIRCUIT_4
    objective: "\uAC70\uC6B8 \uC870\uAC01 3\uC744 \uB4E4\uACE0 \uD68C\uB85C\uD310
      \uB9C8\uC9C0\uB9C9 \uC2AC\uB86F\uC5D0 \uB07C\uC6B0\uC790"
  - doneFlag: F_RA_P5_DONE
    objective: "\uBD81\uCABD \uD0DC\uC591 \uC81C\uB2E8\uC5D0\uC11C \uD558\uB8E8\uC758
      \uC21C\uD658\uC744 \uC644\uC131\uD558\uC790"
  - doneFlag: F_RA_NIGHT_OPEN
    objective: "\uB77C\uC758 \uC131\uC18C\uB85C \uB3CC\uC544\uAC00 \uB77C\uC640 \uC774\uC57C\uAE30\uD558\uC790"
  - doneFlag: F_RA_SHRINE_NIGHT_TALKED
    objective: "\uBC24\uC774 \uB0B4\uB824\uC549\uC558\uB2E4. \uB77C\uC758 \uC131\uC18C\uC5D0
      \uB2E4\uC2DC \uB9D0\uC744 \uAC78\uC5B4 \uBCF4\uC790"
  - doneFlag: F_RA_NIGHT_P1_DONE
    objective: "\uD478\uB978 \uBD88\uC774 \uCF1C\uC9C4 \uB3D9\uCABD \uBC29, \uBC24\uC758
      \uADF8\uB9BC\uC790\uB97C \uC77D\uC790"
