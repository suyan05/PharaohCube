  plateGivenFlag: F_RA_PLATE_GIVEN
  nightMessage: "\uC2E0\uC804\uC5D0 \uBC24\uC774 \uB0B4\uB824\uC549\uC558\uB2E4.
    \uBE44\uC11D\uC758 \uAE00\uC774 \uBC14\uB010 \uAC83 \uAC19\uB2E4."
  shakeDuration: 0.8
  shakeStrength: 0.15
  beforeTrialLines:
  - portrait: 0
    text: "\uB098\uB97C \uC548\uB2E4 \uB9D0\uD558\uB824\uAC70\uB4E0, \uBA3C\uC800
      \uB098\uC758 \uD558\uB8E8\uB97C \uAC78\uC5B4 \uBCF4\uC544\uB77C."
  - portrait: 0
    text: "\uBE5B\uC774 \uB2FF\uB294 \uACF3\uBD80\uD130 \uAC78\uC5B4\uB77C. \uBE5B\uC740
      \uBB38\uC744 \uC5F0\uB2E4."
  trialPassedLines:
  - portrait: 1
    text: "\uB098\uC758 \uD558\uB8E8\uB97C \uB05D\uAE4C\uC9C0 \uAC78\uC5C8\uAD6C\uB098,
      \uACE0\uACE0\uD559\uC790\uC5EC."
  - portrait: 0
    text: "\uD5C8\uB098 \uC2DC\uB828\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uB2E4. \uB0AE\uC740
      \uB0B4 \uC5BC\uAD74\uC758 \uC808\uBC18\uC77C \uBFD0."
  - portrait: 1
    text: "\uC774\uC81C \uC9C4\uC815\uC73C\uB85C \uC6B0\uB9AC\uB97C \uB4E4\uC5EC\uB2E4\uBCF4\uAC70\uB77C.
      \uBC24\uC758 \uB098\uB97C."
  nightLines:
  - portrait: 2
    text: "\uBC24\uC758 \uB098\uB294 \uAC77\uC9C0 \uC54A\uB294\uB2E4. \uBE44\uC11D\uC740
      \uB4A4\uC9D1\uD78C \uC9C4\uC2E4\uC744 \uB9D0\uD560 \uAC83\uC774\uB2E4."
  - portrait: 2
    text: "\uB0AE\uC5D0 \uBC30\uC6B4 \uAC83\uC744 \uADF8\uB300\uB85C \uBBFF\uC9C0
      \uB9C8\uB77C."
  nightClearedLines:
  - portrait: 1
    text: "\uC800\uC2B9\uC758 \uAC15\uC744 \uAC74\uB108 \uB2E4\uC2DC \uB5A0\uC62C\uB790\uAD6C\uB098."
  - portrait: 1
    text: "\uB098\uC758 \uD615\uD310\uC744 \uAC00\uC838\uAC00\uB77C. \uBD81\uCABD
      \uBB38\uC774 \uB108\uB97C \uAE30\uB2E4\uB9B0\uB2E4."
