  m_Script: {fileID: 11500000, guid: 7d34dbc4d5b24b046988cbccbb8f89e4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SobekHubState
  waterRenderers:
  - {fileID: 1849664527}
  waterBlockers:
  - {fileID: 1849664524}
  showWhenDrained:
  - {fileID: 1541706617}
  - {fileID: 466081227}
  returnSpawn: {fileID: 1954034397}
  drainTime: 3
  cameraFollow: {fileID: 0}
  drainMessage: "\uC2E0\uC804\uC758 \uBB3C\uC774 \uBE60\uC9C4\uB2E4\u2026 \uBB3C
    \uBC11\uC5D0 \uC7A0\uACA8 \uC788\uB358 \uC218\uB85C \uBC14\uB2E5\uACFC \uC218\uC704\uACC4
    \uAE30\uB465\uC774 \uB4DC\uB7EC\uB0AC\uB2E4."
  introLines:
  - "\uCF00\uD504\uB9AC"
  - "\uC5EC\uAE30\uB294 \uC18C\uBCA0\uD06C\uC758 \uC2E0\uC804, \uC170\uB370\uD2B8\uC57C.
    \uBB3C\uC774 \uC2E0\uC804 \uD55C\uAC00\uC6B4\uB370\uAE4C\uC9C0 \uCC28 \uC788\uC5B4."
  - "\uB098"
  - "\uBCBD\uB9C8\uB2E4 \uC545\uC5B4 \uBD80\uC870\u2026 \uC800 \uD070 \uBB38\uC740
    \uC545\uC5B4 \uC785 \uBAA8\uC591\uC774\uB2E4. \uD648\uC774 \uB124 \uAC1C \uBE44\uC5B4
    \uC788\uB2E4."
  - "\uCF00\uD504\uB9AC"
  - "\uB124 \uAC1C\uC758 \uC2DC\uD5D8\uC744 \uC9C0\uB098\uBA74 \uBD80\uC801\uC744
    \uC904 \uAC70\uC57C. \uBE44\uC11D\uC744 \uBA3C\uC800 \uC77D\uC5B4 \uBD10. \uC2DC\uD5D8\uC758
    \uD78C\uD2B8\uAC00 \uC0C8\uACA8\uC838 \uC788\uC5B4."
  drainedLines:
  - "\uCF00\uD504\uB9AC"
  - "\uBB3C\uC774 \uBE60\uC84C\uC5B4! \uC218\uB85C \uBC14\uB2E5\uC774 \uB4DC\uB7EC\uB0AC\uACE0\u2026
    \uC218\uC704\uACC4 \uAE30\uB465\uC5D0\uB3C4 \uC774\uC81C \uC190\uC774 \uB2FF\uACA0\uB2E4."
  - "\uCF00\uD504\uB9AC"
  - "\uD615\uD310\uC740 \uC5BB\uC5C8\uC5B4. \uC228\uC740 \uAC83\uC744 \uB354 \uCC3E\uACE0
    \uC2F6\uC73C\uBA74 \uB458\uB7EC\uBCF4\uACE0, \uB2E4 \uB410\uC73C\uBA74 \uB0A8\uCABD
    \uCD9C\uAD6C\uB85C \uC911\uC559 \uD640\uC5D0 \uB3CC\uC544\uAC00\uC790."
