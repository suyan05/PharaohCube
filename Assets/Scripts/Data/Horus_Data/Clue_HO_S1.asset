  day:
    title: "\uD574\uC758 \uB208"
    body: "\uC0B4\uC544 \uC788\uB294 \uD30C\uB77C\uC624\uB294 \uD638\uB8E8\uC2A4\uC600\uACE0,
      \uC8FD\uC740 \uD30C\uB77C\uC624\uB294 \uC624\uC2DC\uB9AC\uC2A4\uAC00 \uB418\uC5C8\uB2E4.
      \uD638\uB8E8\uC2A4\uC758 \uC624\uB978 \uB208\uC740 \uD574\uB2E4. \uD574\uC758
      \uBE5B\uC740 \uACE7\uAC8C \uB0A0\uC544\uAC00\uACE0, \uB9E4\uC758 \uAC70\uC6B8\uB9CC\uC774
      \uADF8 \uAE38\uC744 \uAEBE\uB294\uB2E4. \uC138\uD2B8\uC758 \uBD89\uC740 \uB3CC\uC740
      \uBE5B\uC744 \uC0BC\uD0A8\uB2E4. \uBE5B\uC740 \uC81C \uAE38\uC744 \uD55C \uBC88
      \uAC00\uB85C\uC9C8\uB7EC\uC57C \uB9E4\uC758 \uB208\uC5D0 \uB2FF\uB294\uB2E4."
    illustration: {fileID: -6363136560682446029, guid: 7959781184afc0e44a00a52ad33558f7, type: 3}
    illustrationTint: {r: 1, g: 1, b: 1, a: 1}
