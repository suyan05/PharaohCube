  clueId: HO_S3
  day:
    title: "\uCC22\uAE34 \uB208"
    body: "\uC138\uD2B8\uB294 \uC544\uB4E4\uC758 \uB208\uC744 \uC5EC\uC12F \uBAAB\uC73C\uB85C
      \uCC22\uC5C8\uB2E4. \uB0C4\uC0C8\uB294 2\uBD84\uC758 1, \uBCF4\uB294 \uAC83\uC740
      4\uBD84\uC758 1, \uC0DD\uAC01\uC740 8\uBD84\uC758 1, \uB4E3\uB294 \uAC83\uC740
      16\uBD84\uC758 1, \uB9DB\uC740 32\uBD84\uC758 1, \uB2FF\uB294 \uAC83\uC740
      64\uBD84\uC758 1. \uD1A0\uD2B8\uB294 \uAC00\uC7A5 \uD070 \uBAAB\uBD80\uD130
      \uC774\uC5C8\uB2E4. \uCF54\uC5D0 \uAC00\uAE4C\uC6B4 \uD770\uC790\uB294 \uB0C4\uC0C8\uB97C,
      \uADC0\uC5D0 \uAC00\uAE4C\uC6B4 \uD770\uC790\uB294 \uC18C\uB9AC\uB97C \uB9E1\uACE0,
      \uB208\uC379 \uC544\uB798\uC5D0\uC11C \uC0DD\uAC01\uC774 \uC790\uB780\uB2E4.
      \uC2F9 \uD2B8\uB294 \uB098\uC120\uC740 \uB9DB, \uB545\uC744 \uB51B\uB294 \uB208\uBB3C\uC120\uC740
      \uB2FF\uC74C\uC774\uB2E4."
    illustration: {fileID: 7711739741400993068, guid: 8095ad39732dffe4fb7d1ac24d335ae0, type: 3}
    illustrationTint: {r: 1, g: 1, b: 1, a: 1}
