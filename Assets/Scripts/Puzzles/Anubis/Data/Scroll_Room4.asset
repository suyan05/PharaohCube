  scrollId: SCROLL_ANUBIS_4
  title: "\uC2EC\uD310\uAD00\uC758  \uC11C"
  pieceCount: 5
  stageCount: 3
  fullText: "\ub9c8\uc544\ud2b8\uc758 \ud310 \uc704\uc5d0\uc11c\ub294 \uc2e0\ub4e4\uc758 \ubb34\uac8c\uac00 \uace7 \uc218\uc774\ub2c8,\n\uadf8 \uc11c\uc5f4\uc744 \uc78a\uc9c0 \ub9d0\ub77c.\n\n\ud0dc\uc591\uc744 \uad74\ub9ac\ub294 \uc1e0\ub625\uad6c\ub9ac(\uc2a4\uce74\ub77c\ube0c)\ub294 \ud558\ub098,\n\ud63c\ub3c8\uc758 \ubc40 \uc544\ud3a9\uc740 \ub458, \uc9c0\ud61c\uc758 \ub530\uc624\uae30 \ud1a0\ud2b8\ub294 \uc14b,\n\ubc24\uc744 \uc9c0\ud0a4\ub294 \uace0\uc591\uc774 \ubc14\uc2a4\ud14c\ud2b8\ub294 \ub137.\n---\n\uc2ec\ud310\uc758 \uc790\uce7c \uc544\ub204\ube44\uc2a4\ub294 \ub2e4\uc12f\uc774\ub2c8\n\uc5b8\uc81c\ub098 \ud310\uc758 \ud55c\uac00\uc6b4\ub370\uc5d0 \uc549\ub294\ub2e4.\n\ub098\uc77c\uc758 \uc545\uc5b4 \uc18c\ubca0\ud06c\ub294 \uc5ec\uc12f, \uc804\uc7c1\uc758 \uc0ac\uc790 \uc138\ud06c\uba54\ud2b8\ub294 \uc77c\uacf1,\n\uc2ec\uc7a5\uc744 \uc0bc\ud0a4\ub294 \uc554\ubb34\ud2b8\ub294 \uc5ec\ub35f, \ud558\ub298\uc758 \ub9e4 \ud638\ub8e8\uc2a4\ub294 \uc544\ud649\uc774\ub2e4.\n---\n\uac00\ub85c \uc138 \uc904, \uc138\ub85c \uc138 \uc904, \ub450 \ub300\uac01\uc120.\n\uc5ec\ub35f \uc904 \ubaa8\ub450 \uc2e0\ub4e4\uc758 \uc218\ub97c \ub354\ud574 \uc5f4\ub2e4\uc12f\uc774 \ub418\uac8c \ud558\ub77c."
  pieceSprites:
